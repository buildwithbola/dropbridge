{
  "name": "DropBridge",
  "short_name": "DropBridge",
  "description": "Bridge the gap between screen and pocket. Zero-hassle PC-to-phone file, photo, video, and clipboard transfers.",
  "start_url": "/bridge",
  "display": "standalone",
  "background_color": "#10375C",
  "theme_color": "#10375C",
  "orientation": "any",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/api/share-target",
    "method": "GET",
    "params": {
      "title": "shared_title",
      "text": "shared_text",
      "url": "shared_url"
    }
  }
}
