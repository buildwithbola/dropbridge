{
  "name": "dropbridge",
  "version": "1.2.0",
  "private": true,
  "main": "electron/main.cjs",
  "description": "DropBridge — Bridge the gap between screen and pocket. Zero-hassle cross-platform PC-to-phone file, media, and clipboard transfer.",
  "author": {
    "name": "DropBridge"
  },
  "scripts": {
    "dev": "concurrently -n \"WEB,SIGNAL\" -c \"cyan,yellow\" \"npm run dev:web\" \"npm run dev:signal\"",
    "dev:web": "next dev -H 0.0.0.0 -p 3000",
    "dev:signal": "node server/signaling.mjs",
    "build": "next build",
    "start": "concurrently -n \"WEB,SIGNAL\" -c \"cyan,yellow\" \"next start -H 0.0.0.0 -p 3000\" \"node server/signaling.mjs\"",
    "start:web": "next start -H 0.0.0.0 -p 3000",
    "start:signal": "node server/signaling.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "desktop:prepare": "node -e \"process.env.DROPBRIDGE_DESKTOP='1'; require('child_process').execSync('npm run build && node scripts/prepare-desktop.mjs', { stdio: 'inherit', env: process.env })\"",
    "desktop:dev": "electron .",
    "dist:win": "npm run desktop:prepare && electron-builder --win",
    "dist:mac": "npm run desktop:prepare && electron-builder --mac",
    "dist:linux": "npm run desktop:prepare && electron-builder --linux",
    "dist:all": "npm run desktop:prepare && electron-builder -mwl"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "fflate": "^0.8.2",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "app.dropbridge.desktop",
    "productName": "DropBridge",
    "copyright": "Copyright © 2026 DropBridge",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-bundle",
        "to": "app-bundle"
      },
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DropBridge"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-Portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility;Network;",
      "synopsis": "Zero-hassle PC-to-phone file, photo, video & clipboard bridge",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
